<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:iconTint="?attr/colorControlNormal"
        app:title="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ======================== Claude Card ======================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/claudeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Provider Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider_claude"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <!-- Service Changed Banner -->
                    <TextView
                        android:id="@+id/claude_service_changed_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="?attr/colorErrorContainer"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:text="@string/claude_service_changed_message"
                        android:visibility="gone"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/claudeLoadingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ProgressBar
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_loading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/loading"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Logged Out State -->
                    <LinearLayout
                        android:id="@+id/claudeLoggedOutContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/please_log_in"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/claudeLoginButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="@string/log_in" />
                    </LinearLayout>

                    <!-- Usage Data State -->
                    <LinearLayout
                        android:id="@+id/claudeUsageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Usage layout: robot icon + progress bars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layoutDirection="ltr"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Left robot: icon -->
                            <ImageView
                                android:id="@+id/claudeRobotIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/cd_working_robot"
                                android:src="@drawable/working"
                                android:scaleType="fitCenter" />

                            <!-- Center: usage details or countdown -->
                            <LinearLayout
                                android:id="@+id/claudeUsageDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:orientation="vertical">

                                <!-- 5-hour resets in -->
                                <TextView
                                    android:id="@+id/claudeFiveHourResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                                <!-- 5-hour progress bar -->
                                <ProgressBar
                                    android:id="@+id/claudeFiveHourProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_five_hour" />

                                <!-- Weekly progress bar -->
                                <ProgressBar
                                    android:id="@+id/claudeWeeklyProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_weekly" />

                                <!-- Weekly resets in -->
                                <TextView
                                    android:id="@+id/claudeWeeklyResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>

                            <!-- Hidden placeholder — task 6 will remove this reference -->
                            <TextView
                                android:id="@+id/claudeLimitCountdown"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <!-- Short format: HH : MM : SS -->
                            <LinearLayout
                                android:id="@+id/claudeCountdownShortContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <!-- Hours -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeShortHours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_hours" />

                                    <TextView
                                        android:id="@+id/claudeShortHoursLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_hours"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Minutes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeShortMinutes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_minutes" />

                                    <TextView
                                        android:id="@+id/claudeShortMinutesLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_minutes"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Seconds -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeShortSeconds"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_seconds" />

                                    <TextView
                                        android:id="@+id/claudeShortSecondsLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_seconds"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Long format: DD : HH : MM -->
                            <LinearLayout
                                android:id="@+id/claudeCountdownLongContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <!-- Days -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeLongDays"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_days" />

                                    <TextView
                                        android:id="@+id/claudeLongDaysLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_days"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Hours -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeLongHours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_hours" />

                                    <TextView
                                        android:id="@+id/claudeLongHoursLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_hours"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Minutes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/claudeLongMinutes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_minutes" />

                                    <TextView
                                        android:id="@+id/claudeLongMinutesLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_minutes"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/claudeLastCheckedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Claude Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/claudeRefreshButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/refresh_now" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/claudeLogoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/logout" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== Kimi Card ======================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/kimiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Provider Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider_kimi"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/kimiLoadingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ProgressBar
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_loading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/loading"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Logged Out State -->
                    <LinearLayout
                        android:id="@+id/kimiLoggedOutContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/please_log_in_kimi"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kimiLoginButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/kimi_orange"
                            android:minHeight="48dp"
                            android:text="@string/log_in" />
                    </LinearLayout>

                    <!-- Usage Data State -->
                    <LinearLayout
                        android:id="@+id/kimiUsageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Robot icon + progress bars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layoutDirection="ltr"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Left robot icon -->
                            <ImageView
                                android:id="@+id/kimiRobotIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="@string/cd_working_robot"
                                android:src="@drawable/working" />

                            <!-- Center: usage details or countdown -->
                            <LinearLayout
                                android:id="@+id/kimiUsageDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:orientation="vertical">

                                <!-- 5-hour resets in -->
                                <TextView
                                    android:id="@+id/kimiFiveHourResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                                <!-- 5-hour progress bar -->
                                <ProgressBar
                                    android:id="@+id/kimiFiveHourProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_five_hour" />

                                <!-- Weekly progress bar -->
                                <ProgressBar
                                    android:id="@+id/kimiWeeklyProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_weekly" />

                                <!-- Weekly resets in -->
                                <TextView
                                    android:id="@+id/kimiWeeklyResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>

                            <!-- Hidden placeholder — task 6 will remove this reference -->
                            <TextView
                                android:id="@+id/kimiLimitCountdown"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <!-- Short format: HH : MM : SS -->
                            <LinearLayout
                                android:id="@+id/kimiCountdownShortContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <!-- Hours -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiShortHours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_hours" />

                                    <TextView
                                        android:id="@+id/kimiShortHoursLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_hours"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Minutes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiShortMinutes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_minutes" />

                                    <TextView
                                        android:id="@+id/kimiShortMinutesLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_minutes"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Seconds -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiShortSeconds"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_seconds" />

                                    <TextView
                                        android:id="@+id/kimiShortSecondsLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_seconds"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Long format: DD : HH : MM -->
                            <LinearLayout
                                android:id="@+id/kimiCountdownLongContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <!-- Days -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiLongDays"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_days" />

                                    <TextView
                                        android:id="@+id/kimiLongDaysLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_days"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Hours -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiLongHours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_hours" />

                                    <TextView
                                        android:id="@+id/kimiLongHoursLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_hours"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>

                                <!-- Colon -->
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/countdown_separator"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <!-- Minutes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <com.tokenaddict.app.ui.CountdownDigitView
                                        android:id="@+id/kimiLongMinutes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minWidth="48dp"
                                        android:background="@drawable/countdown_segment_background"
                                        android:paddingHorizontal="12dp"
                                        android:paddingVertical="10dp"
                                        android:contentDescription="@string/cd_countdown_minutes" />

                                    <TextView
                                        android:id="@+id/kimiLongMinutesLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="@string/countdown_minutes"
                                        android:textSize="10sp"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/kimiLastCheckedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Kimi Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiRefreshButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/refresh_now" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiLogoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/logout" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
