<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration

  Pins are SHA-256 SPKI hashes fetched via openssl on 2026-07-14.
  Each domain pins the intermediate CA and its root (or a backup root).
  Pinning the intermediate + root avoids breakage on every leaf renewal.

  IMPORTANT: Before releasing to production, verify pins match live certificates
  by running:
    echo | openssl s_client -connect DOMAIN:443 -showcerts 2>/dev/null
  and extracting SPKI hashes from each certificate in the chain.

  Pin expiration: 2027-12-31 — renew pins before this date.
-->
<network-security-config>

    <!-- Block all cleartext (HTTP) traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      claude.ai / www.claude.ai
      CA: Let's Encrypt (YE1 intermediate, Root YE, cross-signed by ISRG Root X2)
      Fetched: 2026-07-14
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">claude.ai</domain>
        <pin-set expiration="2027-12-31">
            <!-- Intermediate CA: Let's Encrypt YE1 -->
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
            <!-- Root CA: Let's Encrypt Root YE -->
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
            <!-- Backup root CA: ISRG Root X2 -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/root_ye" />
        </trust-anchors>
    </domain-config>

    <!--
      anthropic.com (includes assets-proxy.anthropic.com via includeSubdomains)
      CA: Let's Encrypt (YE1 intermediate, Root YE, cross-signed by ISRG Root X2)
      Fetched: 2026-08-31
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">anthropic.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- Intermediate CA: Let's Encrypt YE1 -->
            <pin digest="SHA-256">brzvtCELCIZUo4sD/qPX0ccRtPsd3DY6RfmxpOU9oB4=</pin>
            <!-- Root CA: Let's Encrypt Root YE -->
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
            <!-- Backup root CA: ISRG Root X2 -->
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/root_ye" />
        </trust-anchors>
    </domain-config>

    <!--
      auth.kimi.com
      CA: Google Trust Services (WE1 intermediate, GTS Root R4)
      Fetched: 2026-07-14
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">auth.kimi.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- Intermediate CA: Google Trust Services WE1 -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <!-- Root CA: Google Trust Services GTS Root R4 -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!--
      api.kimi.com
      CA: Google Trust Services (WE1 intermediate, GTS Root R4)
      Fetched: 2026-07-14
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.kimi.com</domain>
        <pin-set expiration="2027-12-31">
            <!-- Intermediate CA: Google Trust Services WE1 -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <!-- Root CA: Google Trust Services GTS Root R4 -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
