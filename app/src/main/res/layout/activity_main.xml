                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:orientation="vertical">

                                <!-- 5-hour resets in -->
                                <TextView
                                    android:id="@+id/kimiFiveHourResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                                <!-- 5-hour progress bar -->
                                <com.tokenaddict.app.ui.ProgressWithMarkerView
                                    android:id="@+id/kimiFiveHourProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_five_hour" />

                                <!-- Weekly progress bar -->
                                <com.tokenaddict.app.ui.ProgressWithMarkerView
                                    android:id="@+id/kimiWeeklyProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_weekly" />

                                <!-- Weekly resets in -->
                                <TextView
                                    android:id="@+id/kimiWeeklyResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>

                            <!-- Hidden placeholder — task 6 will remove this reference -->
                            <TextView
                                android:id="@+id/kimiLimitCountdown"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <!-- Short format: HH : MM : SS -->
                            <include
                                layout="@layout/countdown_section"
                                android:id="@+id/kimi_countdown_short"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:layout_gravity="center_vertical"
                                android:visibility="gone" />

                            <!-- Long format: DD : HH : MM -->
                            <include
                                layout="@layout/countdown_section"
                                android:id="@+id/kimi_countdown_long"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:layout_gravity="center_vertical"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/kimiLastCheckedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Kimi Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiRefreshButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/refresh_now" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiLogoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/logout" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== ChatGPT Card ======================== -->
