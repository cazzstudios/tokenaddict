<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:iconTint="?attr/colorControlNormal"
        app:title="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ======================== Claude Card ======================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/claudeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Provider Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider_claude"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <!-- Service Changed Banner -->
                    <TextView
                        android:id="@+id/claude_service_changed_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="?attr/colorErrorContainer"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:text="@string/claude_service_changed_message"
                        android:visibility="gone"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/claudeLoadingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ProgressBar
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_loading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/loading"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Logged Out State -->
                    <LinearLayout
                        android:id="@+id/claudeLoggedOutContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/please_log_in"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/claudeLoginButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="@string/log_in" />
                    </LinearLayout>

                    <!-- Usage Data State -->
                    <LinearLayout
                        android:id="@+id/claudeUsageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Usage layout: robot icons flanking progress bars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layoutDirection="ltr"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Left robot: working -->
                            <ImageView
                                android:id="@+id/claudeWorkingRobot"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/cd_working_robot"
                                android:src="@drawable/working"
                                android:scaleType="fitCenter" />

                            <!-- Center: labels + progress bars -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:orientation="vertical">

                                <!-- 5-hour resets in -->
                                <TextView
                                    android:id="@+id/claudeFiveHourResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                                <!-- 5-hour progress bar -->
                                <ProgressBar
                                    android:id="@+id/claudeFiveHourProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_five_hour" />

                                <!-- Weekly progress bar -->
                                <ProgressBar
                                    android:id="@+id/claudeWeeklyProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_weekly" />

                                <!-- Weekly resets in -->
                                <TextView
                                    android:id="@+id/claudeWeeklyResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>

                            <!-- Right robot: resting -->
                            <ImageView
                                android:id="@+id/claudeRestingRobot"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/cd_resting_robot"
                                android:src="@drawable/resting"
                                android:scaleType="fitCenter" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/claudeLastCheckedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Claude Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/claudeRefreshButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/refresh_now" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/claudeLogoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/logout" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== Kimi Card ======================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/kimiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Provider Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider_kimi"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/kimiLoadingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ProgressBar
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/cd_loading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/loading"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <!-- Logged Out State -->
                    <LinearLayout
                        android:id="@+id/kimiLoggedOutContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/please_log_in_kimi"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/kimiLoginButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/kimi_orange"
                            android:minHeight="48dp"
                            android:text="@string/log_in" />
                    </LinearLayout>

                    <!-- Usage Data State -->
                    <LinearLayout
                        android:id="@+id/kimiUsageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Symmetric usage data: robots + progress bars -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layoutDirection="ltr"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Left robot icon -->
                            <ImageView
                                android:id="@+id/kimiWorkingRobot"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="@string/cd_working_robot"
                                android:src="@drawable/working" />

                            <!-- Center: labels + progress bars -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- 5-hour resets in -->
                                <TextView
                                    android:id="@+id/kimiFiveHourResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                                <!-- 5-hour progress bar -->
                                <ProgressBar
                                    android:id="@+id/kimiFiveHourProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_five_hour" />

                                <!-- Weekly progress bar -->
                                <ProgressBar
                                    android:id="@+id/kimiWeeklyProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progressTint="@color/progress_weekly" />

                                <!-- Weekly resets in -->
                                <TextView
                                    android:id="@+id/kimiWeeklyResetsIn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>

                            <!-- Right robot icon -->
                            <ImageView
                                android:id="@+id/kimiRestingRobot"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="@string/cd_resting_robot"
                                android:src="@drawable/resting" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/kimiLastCheckedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Kimi Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiRefreshButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:minHeight="48dp"
                                android:text="@string/refresh_now" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/kimiLogoutButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:text="@string/logout" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
