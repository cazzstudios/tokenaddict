<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base rounded rectangle with secondary container fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Subtle top/bottom shading for 3D split-flap depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00000000"
                android:endColor="#12000000"
                android:startColor="#12000000"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Split-flap seam: dark band at center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#22000000"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:startColor="#00000000"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</layer-list>
