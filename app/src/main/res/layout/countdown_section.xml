<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- Days column (hidden by default, shown for long format) -->
    <LinearLayout
        android:id="@+id/days_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <com.tokenaddict.app.ui.CountdownDigitView
            android:id="@+id/days_digit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:background="@drawable/countdown_segment_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:contentDescription="@string/cd_countdown_days" />
        <TextView
            android:id="@+id/days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/countdown_days"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Days colon -->
    <TextView
        android:id="@+id/days_colon"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/countdown_separator"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <!-- Hours column -->
    <LinearLayout
        android:id="@+id/hours_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <com.tokenaddict.app.ui.CountdownDigitView
            android:id="@+id/hours_digit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:background="@drawable/countdown_segment_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:contentDescription="@string/cd_countdown_hours" />
        <TextView
            android:id="@+id/hours_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/countdown_hours"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Colon separator -->
    <TextView
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/countdown_separator"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <!-- Minutes column -->
    <LinearLayout
        android:id="@+id/minutes_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <com.tokenaddict.app.ui.CountdownDigitView
            android:id="@+id/minutes_digit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:background="@drawable/countdown_segment_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:contentDescription="@string/cd_countdown_minutes" />
        <TextView
            android:id="@+id/minutes_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/countdown_minutes"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Colon separator -->
    <TextView
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/countdown_separator"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <!-- Seconds column -->
    <LinearLayout
        android:id="@+id/seconds_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <com.tokenaddict.app.ui.CountdownDigitView
            android:id="@+id/seconds_digit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:background="@drawable/countdown_segment_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:contentDescription="@string/cd_countdown_seconds" />
        <TextView
            android:id="@+id/seconds_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/countdown_seconds"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
